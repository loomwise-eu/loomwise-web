---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Contact"
  description="Get in touch with Loomwise about process automation, systems integration or EU AI Act compliance."
>
  <section class="section weave">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Talk to us</h1>
      <p class="lede" style="margin-top: 1.25rem;">
        Tell us what the repetitive part of your week looks like. If there is
        nothing worth automating, we will tell you that — it is a shorter
        conversation and a better outcome than a project that should not have
        started.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap contact-grid">
      <div class="stack">
        <h2>Direct</h2>
        <p class="muted">
          Email reaches us fastest. A sentence or two about your situation is
          enough for a useful first reply.
        </p>

        <dl class="contact-details">
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>

          {
            site.phone && (
              <>
                <dt>Phone</dt>
                <dd>
                  <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
                </dd>
              </>
            )
          }

          {
            site.linkedin && (
              <>
                <dt>LinkedIn</dt>
                <dd>
                  <a href={site.linkedin} rel="me noopener">Company page</a>
                </dd>
              </>
            )
          }

          <dt>Languages</dt>
          <dd>English, German, Polish</dd>
        </dl>

        {
          site.bookingUrl && (
            <div class="btn-row">
              <a class="btn btn--primary" href={site.bookingUrl}>
                Book a 30-minute call
              </a>
            </div>
          )
        }
      </div>

      <aside class="card">
        <h3>Registered office</h3>
        <p class="muted" style="margin-top: 0.5rem;">
          {site.legalName}<br />
          {site.address.street}<br />
          {site.address.postalCode}&nbsp;{site.address.city}<br />
          {site.address.country}
        </p>
        <p class="small muted" style="margin-top: 1rem;">
          This is our registered address for correspondence. Client work is
          delivered on site across the EU and remotely.
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap prose">
      <h2>What happens next</h2>
      <ol>
        <li>
          You write, or book a call. We reply within one working day.
        </li>
        <li>
          A 30-minute conversation about your processes. No presentation, no
          sales deck.
        </li>
        <li>
          If it looks like there is something to do, we propose an audit with a
          fixed fee and a fixed scope. If not, we say so.
        </li>
      </ol>
      <p class="small">
        This site has no contact form on purpose: a form means a third-party
        processor and a cookie banner, for no benefit over an email address.
      </p>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 52rem) {
    .contact-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .contact-details {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.6rem 2rem;
    margin-top: 1.5rem;
  }

  .contact-details dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: 0.2rem;
  }

  .contact-details dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 32rem) {
    .contact-details {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .contact-details dd {
      margin-bottom: 0.85rem;
    }
  }
</style>
