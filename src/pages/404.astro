---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="section weave" style="padding-block: clamp(4rem, 9vw, 8rem);">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That thread ran out</h1>
      <p class="lede" style="margin-top: 1.25rem;">
        The page you asked for does not exist — it may have been moved or the
        link may be mistyped.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Back to the start</a>
        <a class="btn btn--ghost" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Base>
