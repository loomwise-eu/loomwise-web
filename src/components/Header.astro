---
import { site } from '../data/site';

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/eu-ai-act/', label: 'EU AI Act' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === href.slice(0, -1);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <svg
        class="brand-mark"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <!-- Warp and weft: two vertical threads crossed by two horizontal ones -->
        <path d="M8 2v20M16 2v20" />
        <path d="M2 8h20M2 16h20" />
      </svg>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contact/" class="btn btn--primary header-cta">Talk to us</a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: color-mix(in oklab, var(--linen) 88%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-right: auto;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand-mark {
    width: 22px;
    height: 22px;
    color: var(--copper);
    flex: none;
  }

  nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    color: var(--ink-muted);
    font-size: 0.95rem;
    font-weight: 500;
    padding-block: 0.5rem;
  }

  nav a:hover {
    color: var(--copper);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--copper);
  }

  /* Below the fold of small screens the nav wraps under the brand rather than
     hiding behind a menu button — three links do not justify the JavaScript. */
  @media (max-width: 46rem) {
    .header-inner {
      flex-wrap: wrap;
      padding-block: 0.85rem;
      gap: 0.75rem 1.25rem;
    }
    .brand {
      margin-right: auto;
    }
    nav {
      order: 3;
      width: 100%;
      border-top: 1px solid var(--rule);
      padding-top: 0.65rem;
    }
    nav ul {
      gap: 1.25rem;
    }
    .header-cta {
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
    }
  }
</style>
